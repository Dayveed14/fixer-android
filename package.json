{
  "name": "fixer-android",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fixer for Android \u2014 the Android-designed front end, wrapped with Capacitor. Same backend as fixerng.app.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "sync": "npm run build && npx cap sync android",
    "check-shared": "node scripts/check-shared.mjs",
    "assets": "npx @capacitor/assets@3 generate --android --iconBackgroundColor \"#0d1442\" --iconBackgroundColorDark \"#0d1442\" --splashBackgroundColor \"#0d1442\" --splashBackgroundColorDark \"#0d1442\""
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "axios": "^1.18.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.19"
  }
}
