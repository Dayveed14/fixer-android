# Copy to .env (Vite reads it at build time).
# Same backend as the website.
VITE_API_BASE_URL=https://fixer-backend-7mng.onrender.com
# Paystack PUBLIC key (pk_test_… / pk_live_…). Never the secret key.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
